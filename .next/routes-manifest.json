      "routeKeys": {
        "nxtPlocale": "nxtPlocale",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlocale>[^/]+?)/services/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[locale]/terms",
      "regex": "^/([^/]+?)/terms(?:/)?$",
