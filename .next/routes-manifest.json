    },
    {
      "page": "/apple-icon",
      "regex": "^/apple\\-icon(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apple\\-icon(?:/)?$"
    },
    {
      "page": "/icon",
      "regex": "^/icon(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon(?:/)?$"
    },
    {
      "page": "/opengraph-image",
