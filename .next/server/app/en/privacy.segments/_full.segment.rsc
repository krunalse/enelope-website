5:[["$","$L10",null,{"locale":"en"}],["$","$L11",null,{"locale":"en","dict":{"meta":{"home":{"title":"Enelope — AI Agents, Chatbots, Cloud & Consulting","description":"Enelope designs and deploys AI agents, chatbots, and cloud infrastructure — backed by consulting that tells you where automation actually pays off."},"about":{"title":"About","description":"Enelope is a small, senior team building AI agents, chatbots, and cloud infrastructure that actually make it to production."},"services":{"title":"Services","description":"AI agents, chatbots, cloud infrastructure, and consulting — Enelope's four core services."},"caseStudies":{"title":"Case Studies","description":"Recent Enelope engagements across logistics, analytics, and e-commerce."},"contact":{"title":"Contact","description":"Tell us about your project — we reply within one business day."},"privacy":{"title":"Privacy Policy","description":"How Enelope collects, uses, and protects your information."},"terms":{"title":"Terms of Service","description":"The terms governing use of the enelope.ch website."}},"nav":{"services":"Services","caseStudies":"Case Studies","about":"About","startProject":"Start a project","openMenu":"Open menu","closeMenu":"Close menu"},"footer":{"tagline":"AI Agents · Chatbots · Cloud · Consulting — built for teams who want automation they can actually trust.","companyHeading":"Company","servicesHeading":"Services","legalHeading":"Legal","aboutLink":"About","caseStudiesLink":"Case Studies","contactLink":"Contact","aiAgentsLink":"AI Agents","chatbotsLink":"Chatbots","cloudLink":"Cloud","consultingLink":"Consulting","privacyLink":"Privacy","termsLink":"Terms","copyright":"© {year} Enelope. All rights reserved.","builtWith":"Built with Next.js & Supabase"},"themeToggle":{"toLight":"Switch to light mode","toDark":"Switch to dark mode"},"languageSwitcher":{"label":"Language"},"home":{"hero":{"badge":"AI Agents · Chatbots · Cloud · Consulting","title":"Automation your team will actually trust.","subtitle":"Enelope designs AI agents and chatbots, builds the cloud infrastructure underneath them, and tells you honestly where automation earns its keep — and where it doesn't.","startProject":"Start a project","seeCaseStudies":"See case studies","diagramAlt":"Diagram connecting AI agents, chatbots, cloud, and consulting around a central node","nodeAgents":"Agents","nodeChatbots":"Chatbots","nodeCloud":"Cloud","nodeConsulting":"Consulting"},"valueProp":{"eyebrow":"Why Enelope","title":"We build the automation, not just the demo.","description":"Most AI projects stall between the prototype and production. We close that gap — grounding every agent and chatbot in your real data, your real systems, and infrastructure that holds up under real load.","stat1Value":"3 weeks","stat1Label":"average time to first working agent","stat2Value":"100%","stat2Label":"of engagements start with a no-build consulting phase","stat3Value":"24/7","stat3Label":"coverage once a chatbot or agent goes live"},"servicesPreview":{"eyebrow":"What we do","title":"Four ways we help you automate with confidence."},"capabilities":{"eyebrow":"Technology","title":"A stack built for production, not demos.","description":"We're model-agnostic and infrastructure-pragmatic — the goal is the right tool for your constraints, not the newest one.","items":[{"label":"LLM orchestration","detail":"Claude, GPT, and open-weight models"},{"label":"Retrieval & memory","detail":"Vector search grounded in your data"},{"label":"Workflow automation","detail":"Multi-step agents with human handoff"},{"label":"Cloud infrastructure","detail":"AWS, GCP, and Supabase-based stacks"},{"label":"Integrations","detail":"Slack, Teams, CRM, and internal tools"},{"label":"Observability","detail":"Logging, evals, and cost monitoring"}]},"whyChooseUs":{"eyebrow":"Why choose Enelope","title":"Automation that earns your trust before it earns autonomy.","reasons":[{"title":"We say no to bad ideas","body":"If automation isn't the right call, we tell you before you pay for it — not after."},{"title":"Built to run, not just to demo","body":"Every agent and chatbot ships with monitoring, fallbacks, and a plan for when it's wrong."},{"title":"Your team stays in control","body":"We hand off documentation and ownership — no black boxes, no permanent dependency on us."}]},"process":{"eyebrow":"Process","title":"How an engagement runs.","steps":[{"title":"Assess","body":"We map your workflows and find where automation would actually change outcomes."},{"title":"Design","body":"We scope the smallest version of the agent, chatbot, or infrastructure that proves the case."},{"title":"Build","body":"We build against your real systems and data, with monitoring in place from day one."},{"title":"Operate","body":"We hand off documentation and support your team as usage — and confidence — grows."}]},"caseStudiesSection":{"eyebrow":"Case studies","title":"Recent engagements.","viewAll":"View all"},"testimonialsSection":{"eyebrow":"From clients","title":"What it's like to work with us."},"cta":{"title":"Ready to find out where automation actually pays off?","subtitle":"Start with a conversation, not a contract. We'll tell you honestly what's worth building.","startProject":"Start a project"}},"about":{"eyebrow":"About Enelope","title":"A small team that builds AI infrastructure meant to last.","description":"We started Enelope because too many AI projects stall at the prototype stage — impressive in a demo, unreliable in production. We work end to end: consulting on where automation fits, building the agents and chatbots, and standing up the cloud infrastructure underneath.","values":[{"title":"Honest scoping","body":"We turn down work we don't think will pay off, and we say so before the invoice, not after."},{"title":"Production over demos","body":"A prototype that impresses in a meeting and an agent that survives real traffic are different projects. We build the second one."},{"title":"Ownership transfer","body":"You should be able to run what we build without us. Documentation and handoff are part of every engagement."}]},"servicesPage":{"eyebrow":"Services","title":"Four ways we help you automate with confidence.","description":"Every engagement starts with consulting — we don't build until we're confident it's worth building."},"serviceDetail":{"allServices":"All services","talkToUsAbout":"Talk to us about {title}"},"serviceGrid":{"empty":"Services will appear here once they're published."},"serviceCard":{"learnMore":"Learn more"},"caseStudiesPage":{"eyebrow":"Case studies","title":"Recent engagements.","description":"A sample of the work — full write-ups available on request.","items":[{"industry":"Supply Chain","client":"Larkspur Logistics","summary":"Built a triage agent that reads incoming support tickets, checks shipment status across three systems, and drafts a resolution for review.","result":"68% of tickets now resolved without a human draft from scratch."},{"industry":"Data & Analytics","client":"Northfield Analytics","summary":"Migrated inference workloads to a right-sized cloud architecture, replacing a generic always-on setup with autoscaling built for actual traffic patterns.","result":"41% reduction in monthly cloud spend."},{"industry":"E-commerce","client":"Solvent Home Goods","summary":"Ran a two-week consulting sprint to rank automation opportunities, then shipped a product-support chatbot grounded in the catalog and return policy.","result":"Chatbot live in 6 weeks; deflects 35% of pre-purchase questions."}]},"contactPage":{"eyebrow":"Contact","title":"Tell us about your project.","description":"Share a few details and we'll follow up with next steps — no sales pitch, just a straight answer on fit.","emailLabel":"Email","responseTimeLabel":"Response time","responseTimeValue":"Within one business day"},"contactForm":{"nameLabel":"Name","emailLabel":"Email","companyLabel":"Company","phoneLabel":"Phone","serviceLabel":"Service you're interested in","servicePlaceholder":"Select a service","serviceNotSure":"Not sure yet","messageLabel":"Message","successTitle":"Message sent.","successBody":"We reply to every inquiry within one business day.","errorBody":"Something went wrong sending your message. Please try again or email us directly.","sending":"Sending…","submit":"Send message"},"privacyPage":{"title":"Privacy Policy","lastUpdated":"Last updated: August 17, 2026","sections":[{"heading":"Overview","body":"This policy explains what information Enelope (\"we\", \"us\") collects through enelope.ch, how we use it, and who we share it with. It covers this website only — separate agreements govern any client engagement or project work."},{"heading":"Information we collect","intro":"We collect information in two ways:","bullets":[{"label":"Contact form.","body":"When you submit the contact form, we receive the name, email, company, phone number, service of interest, and message you provide."},{"label":"Basic hosting logs.","body":"Our hosting provider (Vercel) automatically logs standard request data (such as IP address and browser type) for security and reliability. We do not use analytics or advertising trackers on this site."}],"outro":"Your theme preference (light or dark mode) is stored locally in your browser and never sent to us."},{"heading":"How we use your information","body":"We use contact form submissions solely to respond to your inquiry. We do not sell your personal data, and we do not use it for marketing unless you separately opt in."},{"heading":"Third-party service providers","intro":"We rely on a small number of subprocessors to run this site and deliver contact form messages:","providers":[{"name":"Supabase","body":"hosts our database, authentication, and file storage for the services and testimonials shown on this site","linkLabel":"privacy policy","href":"https://supabase.com/privacy"},{"name":"Resend","body":"delivers the email generated when you submit the contact form","linkLabel":"privacy policy","href":"https://resend.com/legal/privacy-policy"},{"name":"Vercel","body":"hosts this website","linkLabel":"privacy policy","href":"https://vercel.com/legal/privacy-policy"}]},{"heading":"Cookies","body":"We don't use tracking or advertising cookies. Signing into the admin panel sets a secure, necessary session cookie used only to keep you authenticated."},{"heading":"Data retention","body":"Contact form submissions are emailed directly to our team and are not stored in a database. Services and testimonials content is retained in our database until removed by an administrator."},{"heading":"Your rights","body":"You can ask us what information we hold about you, or request that we delete it, by emailing {email}."},{"heading":"Changes to this policy","body":"We may update this policy from time to time. Material changes will be reflected by updating the date at the top of this page."},{"heading":"Contact","body":"Questions about this policy? Email {email}."}]},"termsPage":{"title":"Terms of Service","lastUpdated":"Last updated: August 17, 2026","sections":[{"heading":"Acceptance of terms","body":"By using enelope.ch (the \"Site\"), you agree to these terms. These terms govern use of the Site only — they don't govern any paid engagement with Enelope, which is covered by a separate signed agreement or statement of work."},{"heading":"Use of the site","body":"The Site is provided for informational purposes — to describe our services, share case studies, and let you get in touch. You agree not to misuse the Site, including attempting to gain unauthorized access to the admin panel or any other non-public part of the Site."},{"heading":"Engaging our services","body":"Descriptions of services on this Site are informational and do not constitute an offer or contract. Project scope, pricing, deliverables, and ownership of work product for any engagement are defined exclusively in a separate written agreement between Enelope and the client."},{"heading":"Intellectual property","body":"The Site's content, design, and the Enelope name and logo are owned by Enelope and may not be copied or reused without permission. This does not apply to deliverables produced under a separate client agreement, which is governed by that agreement's IP terms."},{"heading":"No warranty","body":"The Site is provided \"as is,\" without warranties of any kind. We don't guarantee the Site will be uninterrupted, error-free, or available at all times."},{"heading":"Limitation of liability","body":"To the fullest extent permitted by law, Enelope is not liable for any indirect, incidental, or consequential damages arising from your use of the Site."},{"heading":"Third-party services","body":"The Site relies on third-party providers (Supabase, Resend, Vercel) to operate. We aren't responsible for outages or issues originating from those providers."},{"heading":"Governing law","body":"These terms are governed by the laws of Switzerland, without regard to conflict-of-law principles."},{"heading":"Changes to these terms","body":"We may update these terms from time to time. Material changes will be reflected by updating the date at the top of this page."},{"heading":"Contact","body":"Questions about these terms? Email {email}."}]}}}],"$L12","$L13"]
