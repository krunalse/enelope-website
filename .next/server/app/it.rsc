5:[["$","$Lf",null,{"locale":"it"}],["$","$L10",null,{"locale":"it","dict":{"meta":{"home":{"title":"Enelope — Agenti IA, Chatbot, Cloud & Consulenza","description":"Enelope progetta e realizza agenti IA, chatbot e infrastrutture cloud — affiancati da una consulenza che vi dice onestamente dove l'automazione conviene davvero."},"about":{"title":"Chi siamo","description":"Enelope è un piccolo team senior che costruisce agenti IA, chatbot e infrastrutture cloud che arrivano davvero in produzione."},"services":{"title":"Servizi","description":"Agenti IA, chatbot, infrastruttura cloud e consulenza — i quattro servizi principali di Enelope."},"caseStudies":{"title":"Casi di studio","description":"Progetti recenti di Enelope in logistica, analisi dei dati ed e-commerce."},"contact":{"title":"Contatti","description":"Raccontateci il vostro progetto — rispondiamo entro un giorno lavorativo."},"privacy":{"title":"Informativa sulla privacy","description":"Come Enelope raccoglie, utilizza e protegge le vostre informazioni."},"terms":{"title":"Termini di servizio","description":"I termini che regolano l'utilizzo del sito enelope.ch."}},"nav":{"services":"Servizi","caseStudies":"Casi di studio","about":"Chi siamo","startProject":"Avvia un progetto","openMenu":"Apri il menu","closeMenu":"Chiudi il menu"},"footer":{"tagline":"Agenti IA · Chatbot · Cloud · Consulenza — per team che vogliono un'automazione di cui potersi davvero fidare.","companyHeading":"Azienda","servicesHeading":"Servizi","legalHeading":"Legale","aboutLink":"Chi siamo","caseStudiesLink":"Casi di studio","contactLink":"Contatti","aiAgentsLink":"Agenti IA","chatbotsLink":"Chatbot","cloudLink":"Cloud","consultingLink":"Consulenza","privacyLink":"Privacy","termsLink":"Termini","copyright":"© {year} Enelope. Tutti i diritti riservati.","builtWith":"Realizzato con Next.js & Supabase"},"themeToggle":{"toLight":"Passa alla modalità chiara","toDark":"Passa alla modalità scura"},"languageSwitcher":{"label":"Lingua"},"home":{"hero":{"badge":"Agenti IA · Chatbot · Cloud · Consulenza","title":"Automazione di cui il vostro team si fiderà davvero.","subtitle":"Enelope progetta agenti IA e chatbot, costruisce l'infrastruttura cloud sottostante e vi dice onestamente dove l'automazione ripaga — e dove no.","startProject":"Avvia un progetto","seeCaseStudies":"Guarda i casi di studio","diagramAlt":"Diagramma che collega agenti IA, chatbot, cloud e consulenza attorno a un nodo centrale","nodeAgents":"Agenti","nodeChatbots":"Chatbot","nodeCloud":"Cloud","nodeConsulting":"Consulenza"},"valueProp":{"eyebrow":"Perché Enelope","title":"Costruiamo l'automazione, non solo la demo.","description":"La maggior parte dei progetti IA si arena tra il prototipo e la produzione. Noi colmiamo questo divario — ogni agente e chatbot si basa sui vostri dati reali, sui vostri sistemi reali e su un'infrastruttura che regge sotto un carico reale.","stat1Value":"3 settimane","stat1Label":"tempo medio per il primo agente funzionante","stat2Value":"100%","stat2Label":"dei progetti inizia con una fase di consulenza senza impegno di sviluppo","stat3Value":"24/7","stat3Label":"copertura non appena un chatbot o un agente va in produzione"},"servicesPreview":{"eyebrow":"Cosa facciamo","title":"Quattro modi in cui vi aiutiamo ad automatizzare con fiducia."},"capabilities":{"eyebrow":"Tecnologia","title":"Uno stack pensato per la produzione, non per le demo.","description":"Siamo agnostici rispetto ai modelli e pragmatici sull'infrastruttura — l'obiettivo è lo strumento giusto per i vostri vincoli, non il più recente.","items":[{"label":"Orchestrazione LLM","detail":"Claude, GPT e modelli open-weight"},{"label":"Ricerca & memoria","detail":"Ricerca vettoriale basata sui vostri dati"},{"label":"Automazione dei workflow","detail":"Agenti multi-step con passaggio a un operatore umano"},{"label":"Infrastruttura cloud","detail":"Stack basati su AWS, GCP e Supabase"},{"label":"Integrazioni","detail":"Slack, Teams, CRM e strumenti interni"},{"label":"Osservabilità","detail":"Logging, valutazioni e monitoraggio dei costi"}]},"whyChooseUs":{"eyebrow":"Perché scegliere Enelope","title":"Un'automazione che guadagna la vostra fiducia prima di guadagnare autonomia.","reasons":[{"title":"Diciamo no alle cattive idee","body":"Se l'automazione non è la scelta giusta, ve lo diciamo prima che la paghiate — non dopo."},{"title":"Costruito per funzionare, non solo per una demo","body":"Ogni agente e chatbot viene consegnato con monitoraggio, soluzioni di fallback e un piano per quando qualcosa va storto."},{"title":"Il vostro team mantiene il controllo","body":"Trasferiamo documentazione e proprietà — nessuna scatola nera, nessuna dipendenza permanente da noi."}]},"process":{"eyebrow":"Processo","title":"Come si svolge un progetto.","steps":[{"title":"Analisi","body":"Mappiamo i vostri flussi di lavoro e individuiamo dove l'automazione cambierebbe davvero i risultati."},{"title":"Progettazione","body":"Definiamo la versione più piccola dell'agente, del chatbot o dell'infrastruttura in grado di dimostrarne il valore."},{"title":"Sviluppo","body":"Costruiamo sui vostri sistemi e dati reali, con il monitoraggio attivo fin dal primo giorno."},{"title":"Gestione","body":"Trasferiamo la documentazione e supportiamo il vostro team man mano che utilizzo e fiducia crescono."}]},"caseStudiesSection":{"eyebrow":"Casi di studio","title":"Progetti recenti.","viewAll":"Vedi tutti"},"testimonialsSection":{"eyebrow":"Dai clienti","title":"Com'è lavorare con noi."},"cta":{"title":"Pronti a scoprire dove l'automazione conviene davvero?","subtitle":"Iniziate con una conversazione, non con un contratto. Vi diremo onestamente cosa vale la pena costruire.","startProject":"Avvia un progetto"}},"about":{"eyebrow":"Chi è Enelope","title":"Un piccolo team che costruisce infrastrutture IA fatte per durare.","description":"Abbiamo fondato Enelope perché troppi progetti IA si fermano allo stadio di prototipo — impressionanti in una demo, inaffidabili in produzione. Lavoriamo a 360 gradi: consulenza su dove l'automazione ha senso, sviluppo di agenti e chatbot, e realizzazione dell'infrastruttura cloud sottostante.","values":[{"title":"Valutazione onesta","body":"Rifiutiamo incarichi che riteniamo non ripaghino, e lo diciamo prima della fattura, non dopo."},{"title":"Produzione, non solo demo","body":"Un prototipo che impressiona in una riunione e un agente che regge il traffico reale sono due progetti diversi. Noi costruiamo il secondo."},{"title":"Trasferimento di proprietà","body":"Dovreste essere in grado di gestire ciò che costruiamo anche senza di noi. Documentazione e passaggio di consegne fanno parte di ogni progetto."}]},"servicesPage":{"eyebrow":"Servizi","title":"Quattro modi in cui vi aiutiamo ad automatizzare con fiducia.","description":"Ogni progetto inizia con la consulenza — costruiamo solo quando siamo certi che ne valga la pena."},"serviceDetail":{"allServices":"Tutti i servizi","talkToUsAbout":"Parlateci di {title}"},"serviceGrid":{"empty":"I servizi appariranno qui non appena saranno pubblicati."},"serviceCard":{"learnMore":"Scopri di più"},"caseStudiesPage":{"eyebrow":"Casi di studio","title":"Progetti recenti.","description":"Una selezione dei nostri lavori — report completi su richiesta.","items":[{"industry":"Supply chain","client":"Larkspur Logistics","summary":"Realizzazione di un agente di smistamento che legge i ticket di supporto in arrivo, verifica lo stato delle spedizioni su tre sistemi diversi e redige una proposta di risoluzione da verificare.","result":"Il 68% dei ticket viene ora risolto senza una bozza scritta da zero da un operatore."},{"industry":"Dati e analytics","client":"Northfield Analytics","summary":"Migrazione dei carichi di inferenza verso un'architettura cloud dimensionata su misura, sostituendo una configurazione generica sempre attiva con autoscaling basato sui reali pattern di traffico.","result":"Riduzione del 41% della spesa cloud mensile."},{"industry":"E-commerce","client":"Solvent Home Goods","summary":"Sprint di consulenza di due settimane per classificare le opportunità di automazione, seguito dal rilascio di un chatbot di supporto prodotto basato su catalogo e politica di reso.","result":"Chatbot in produzione in 6 settimane; gestisce il 35% delle domande pre-acquisto."}]},"contactPage":{"eyebrow":"Contatti","title":"Raccontateci il vostro progetto.","description":"Condividete qualche dettaglio e vi risponderemo con i prossimi passi — niente discorsi commerciali, solo una risposta onesta sulla fattibilità.","emailLabel":"Email","responseTimeLabel":"Tempo di risposta","responseTimeValue":"Entro un giorno lavorativo"},"contactForm":{"nameLabel":"Nome","emailLabel":"Email","companyLabel":"Azienda","phoneLabel":"Telefono","serviceLabel":"Servizio di vostro interesse","servicePlaceholder":"Seleziona un servizio","serviceNotSure":"Non ancora sicuro","messageLabel":"Messaggio","successTitle":"Messaggio inviato.","successBody":"Rispondiamo a ogni richiesta entro un giorno lavorativo.","errorBody":"Si è verificato un errore durante l'invio del messaggio. Riprovate oppure scriveteci direttamente via email.","sending":"Invio in corso…","submit":"Invia messaggio"},"privacyPage":{"title":"Informativa sulla privacy","lastUpdated":"Ultimo aggiornamento: 17 agosto 2026","sections":[{"heading":"Panoramica","body":"Questa informativa spiega quali informazioni Enelope (\"noi\") raccoglie tramite enelope.ch, come le utilizziamo e con chi le condividiamo. Riguarda solo questo sito — eventuali incarichi o progetti con i clienti sono regolati da accordi separati."},{"heading":"Informazioni che raccogliamo","intro":"Raccogliamo informazioni in due modi:","bullets":[{"label":"Modulo di contatto.","body":"Quando inviate il modulo di contatto, riceviamo nome, email, azienda, numero di telefono, servizio di interesse e il messaggio che fornite."},{"label":"Log di hosting di base.","body":"Il nostro fornitore di hosting (Vercel) registra automaticamente i dati standard delle richieste (come indirizzo IP e tipo di browser) per sicurezza e affidabilità. Non utilizziamo strumenti di analytics o tracker pubblicitari su questo sito."}],"outro":"La vostra preferenza di tema (modalità chiara o scura) viene salvata localmente nel browser e non ci viene mai inviata."},{"heading":"Come utilizziamo le vostre informazioni","body":"Utilizziamo le richieste inviate tramite il modulo di contatto esclusivamente per rispondere alla vostra richiesta. Non vendiamo i vostri dati personali e non li utilizziamo per finalità di marketing, salvo vostro consenso separato."},{"heading":"Fornitori terzi","intro":"Ci affidiamo a un numero limitato di responsabili del trattamento per gestire questo sito e inviare i messaggi del modulo di contatto:","providers":[{"name":"Supabase","body":"ospita il nostro database, l'autenticazione e l'archiviazione dei file per i servizi e le testimonianze mostrati su questo sito","linkLabel":"informativa sulla privacy","href":"https://supabase.com/privacy"},{"name":"Resend","body":"invia l'email generata quando inviate il modulo di contatto","linkLabel":"informativa sulla privacy","href":"https://resend.com/legal/privacy-policy"},{"name":"Vercel","body":"ospita questo sito web","linkLabel":"informativa sulla privacy","href":"https://vercel.com/legal/privacy-policy"}]},{"heading":"Cookie","body":"Non utilizziamo cookie di tracciamento o pubblicitari. L'accesso al pannello di amministrazione imposta un cookie di sessione sicuro e necessario, utilizzato solo per mantenervi autenticati."},{"heading":"Conservazione dei dati","body":"Le richieste inviate tramite il modulo di contatto vengono inoltrate direttamente via email al nostro team e non vengono salvate in un database. I contenuti di servizi e testimonianze vengono conservati nel nostro database finché non vengono rimossi da un amministratore."},{"heading":"I vostri diritti","body":"Potete chiederci quali informazioni deteniamo su di voi, o richiederne la cancellazione, scrivendo a {email}."},{"heading":"Modifiche a questa informativa","body":"Potremmo aggiornare periodicamente questa informativa. Le modifiche sostanziali saranno indicate aggiornando la data in cima a questa pagina."},{"heading":"Contatti","body":"Domande su questa informativa? Scrivete a {email}."}]},"termsPage":{"title":"Termini di servizio","lastUpdated":"Ultimo aggiornamento: 17 agosto 2026","sections":[{"heading":"Accettazione dei termini","body":"Utilizzando enelope.ch (il \"Sito\"), accettate questi termini. Questi termini regolano solo l'utilizzo del Sito — non regolano alcun incarico a pagamento con Enelope, che è disciplinato da un accordo firmato separato o da un disciplinare d'incarico."},{"heading":"Utilizzo del sito","body":"Il Sito viene fornito a scopo informativo — per descrivere i nostri servizi, condividere casi di studio e permettervi di contattarci. Vi impegnate a non abusare del Sito, incluso il tentativo di ottenere accesso non autorizzato al pannello di amministrazione o a qualsiasi altra parte non pubblica del Sito."},{"heading":"Incaricare i nostri servizi","body":"Le descrizioni dei servizi su questo Sito sono a scopo informativo e non costituiscono un'offerta o un contratto. L'ambito del progetto, i prezzi, i deliverable e la proprietà del lavoro prodotto per qualsiasi incarico sono definiti esclusivamente in un accordo scritto separato tra Enelope e il cliente."},{"heading":"Proprietà intellettuale","body":"I contenuti e il design del Sito, così come il nome e il logo Enelope, sono di proprietà di Enelope e non possono essere copiati o riutilizzati senza autorizzazione. Questo non si applica ai deliverable prodotti nell'ambito di un accordo separato con il cliente, disciplinati dai termini di proprietà intellettuale di tale accordo."},{"heading":"Assenza di garanzia","body":"Il Sito viene fornito \"così com'è\", senza garanzie di alcun tipo. Non garantiamo che il Sito sia ininterrotto, privo di errori o disponibile in ogni momento."},{"heading":"Limitazione di responsabilità","body":"Nella misura massima consentita dalla legge, Enelope non è responsabile per danni indiretti, incidentali o consequenziali derivanti dall'utilizzo del Sito."},{"heading":"Servizi di terze parti","body":"Il Sito si affida a fornitori terzi (Supabase, Resend, Vercel) per funzionare. Non siamo responsabili per interruzioni o problemi originati da tali fornitori."},{"heading":"Legge applicabile","body":"Questi termini sono disciplinati dalla legge svizzera, escluse le norme di conflitto di leggi."},{"heading":"Modifiche a questi termini","body":"Potremmo aggiornare periodicamente questi termini. Le modifiche sostanziali saranno indicate aggiornando la data in cima a questa pagina."},{"heading":"Contatti","body":"Domande su questi termini? Scrivete a {email}."}]}}}],"$L11","$L12"]
