5:[["$","$L10",null,{"locale":"fr"}],["$","$L11",null,{"locale":"fr","dict":{"meta":{"home":{"title":"Enelope — Agents IA, Chatbots, Cloud & Conseil","description":"Enelope conçoit et déploie des agents IA, des chatbots et une infrastructure cloud — avec un conseil qui vous dit honnêtement où l'automatisation est réellement rentable."},"about":{"title":"À propos","description":"Enelope est une petite équipe expérimentée qui conçoit des agents IA, des chatbots et une infrastructure cloud qui arrivent réellement en production."},"services":{"title":"Services","description":"Agents IA, chatbots, infrastructure cloud et conseil — les quatre services principaux d'Enelope."},"caseStudies":{"title":"Études de cas","description":"Projets récents d'Enelope dans la logistique, l'analytique et l'e-commerce."},"contact":{"title":"Contact","description":"Parlez-nous de votre projet — nous répondons sous un jour ouvré."},"privacy":{"title":"Politique de confidentialité","description":"Comment Enelope collecte, utilise et protège vos informations."},"terms":{"title":"Conditions d'utilisation","description":"Les conditions régissant l'utilisation du site enelope.ch."}},"nav":{"services":"Services","caseStudies":"Études de cas","about":"À propos","startProject":"Démarrer un projet","openMenu":"Ouvrir le menu","closeMenu":"Fermer le menu"},"footer":{"tagline":"Agents IA · Chatbots · Cloud · Conseil — pour les équipes qui veulent une automatisation en laquelle elles peuvent vraiment avoir confiance.","companyHeading":"Entreprise","servicesHeading":"Services","legalHeading":"Mentions légales","aboutLink":"À propos","caseStudiesLink":"Études de cas","contactLink":"Contact","aiAgentsLink":"Agents IA","chatbotsLink":"Chatbots","cloudLink":"Cloud","consultingLink":"Conseil","privacyLink":"Confidentialité","termsLink":"Conditions","copyright":"© {year} Enelope. Tous droits réservés.","builtWith":"Créé avec Next.js & Supabase"},"themeToggle":{"toLight":"Passer en mode clair","toDark":"Passer en mode sombre"},"languageSwitcher":{"label":"Langue"},"home":{"hero":{"badge":"Agents IA · Chatbots · Cloud · Conseil","title":"Une automatisation à laquelle votre équipe fera vraiment confiance.","subtitle":"Enelope conçoit des agents IA et des chatbots, construit l'infrastructure cloud sous-jacente, et vous dit honnêtement où l'automatisation est rentable — et où elle ne l'est pas.","startProject":"Démarrer un projet","seeCaseStudies":"Voir les études de cas","diagramAlt":"Diagramme reliant agents IA, chatbots, cloud et conseil autour d'un nœud central","nodeAgents":"Agents","nodeChatbots":"Chatbots","nodeCloud":"Cloud","nodeConsulting":"Conseil"},"valueProp":{"eyebrow":"Pourquoi Enelope","title":"Nous construisons l'automatisation, pas seulement la démo.","description":"La plupart des projets d'IA s'arrêtent entre le prototype et la production. Nous comblons cet écart — chaque agent et chatbot s'appuie sur vos données réelles, vos systèmes réels, et une infrastructure qui tient sous une charge réelle.","stat1Value":"3 semaines","stat1Label":"temps moyen jusqu'au premier agent fonctionnel","stat2Value":"100 %","stat2Label":"des projets débutent par une phase de conseil sans engagement de développement","stat3Value":"24/7","stat3Label":"couverture dès qu'un chatbot ou un agent est mis en production"},"servicesPreview":{"eyebrow":"Ce que nous faisons","title":"Quatre façons de vous aider à automatiser en toute confiance."},"capabilities":{"eyebrow":"Technologie","title":"Une stack conçue pour la production, pas pour les démos.","description":"Nous sommes agnostiques vis-à-vis des modèles et pragmatiques en matière d'infrastructure — l'objectif est le bon outil pour vos contraintes, pas le plus récent.","items":[{"label":"Orchestration LLM","detail":"Claude, GPT et modèles à poids ouverts"},{"label":"Recherche & mémoire","detail":"Recherche vectorielle ancrée dans vos données"},{"label":"Automatisation des workflows","detail":"Agents multi-étapes avec transfert vers un humain"},{"label":"Infrastructure cloud","detail":"Stacks basées sur AWS, GCP et Supabase"},{"label":"Intégrations","detail":"Slack, Teams, CRM et outils internes"},{"label":"Observabilité","detail":"Journalisation, évaluations et suivi des coûts"}]},"whyChooseUs":{"eyebrow":"Pourquoi choisir Enelope","title":"Une automatisation qui gagne votre confiance avant de gagner en autonomie.","reasons":[{"title":"Nous disons non aux mauvaises idées","body":"Si l'automatisation n'est pas le bon choix, nous vous le disons avant que vous ne payiez — pas après."},{"title":"Conçu pour fonctionner, pas seulement pour une démo","body":"Chaque agent et chatbot est livré avec supervision, solutions de repli et un plan en cas d'erreur."},{"title":"Votre équipe garde le contrôle","body":"Nous transmettons la documentation et la propriété — pas de boîte noire, pas de dépendance permanente envers nous."}]},"process":{"eyebrow":"Déroulement","title":"Comment se déroule un projet.","steps":[{"title":"Évaluer","body":"Nous cartographions vos workflows et identifions où l'automatisation changerait réellement les résultats."},{"title":"Concevoir","body":"Nous définissons la plus petite version de l'agent, du chatbot ou de l'infrastructure qui démontre sa valeur."},{"title":"Construire","body":"Nous développons avec vos systèmes et données réels, avec une supervision en place dès le premier jour."},{"title":"Exploiter","body":"Nous transmettons la documentation et accompagnons votre équipe à mesure que l'usage — et la confiance — grandissent."}]},"caseStudiesSection":{"eyebrow":"Études de cas","title":"Projets récents.","viewAll":"Voir tout"},"testimonialsSection":{"eyebrow":"Nos clients témoignent","title":"Ce que c'est que de travailler avec nous."},"cta":{"title":"Prêt à découvrir où l'automatisation est vraiment rentable ?","subtitle":"Commencez par une conversation, pas par un contrat. Nous vous dirons honnêtement ce qui mérite d'être construit.","startProject":"Démarrer un projet"}},"about":{"eyebrow":"À propos d'Enelope","title":"Une petite équipe qui construit une infrastructure IA faite pour durer.","description":"Nous avons créé Enelope parce que trop de projets d'IA s'arrêtent au stade du prototype — impressionnants en démo, peu fiables en production. Nous travaillons de bout en bout : conseil sur la pertinence de l'automatisation, développement des agents et chatbots, et mise en place de l'infrastructure cloud sous-jacente.","values":[{"title":"Un cadrage honnête","body":"Nous refusons les projets que nous ne pensons pas rentables, et nous le disons avant la facture, pas après."},{"title":"La production plutôt que la démo","body":"Un prototype qui impressionne en réunion et un agent qui survit à un trafic réel sont deux projets différents. Nous construisons le second."},{"title":"Transfert de propriété","body":"Vous devriez pouvoir faire fonctionner ce que nous construisons sans nous. La documentation et la transmission font partie de chaque projet."}]},"servicesPage":{"eyebrow":"Services","title":"Quatre façons de vous aider à automatiser en toute confiance.","description":"Chaque projet commence par du conseil — nous ne construisons que lorsque nous sommes certains que cela en vaut la peine."},"serviceDetail":{"allServices":"Tous les services","talkToUsAbout":"Parlez-nous de {title}"},"serviceGrid":{"empty":"Les services apparaîtront ici dès qu'ils seront publiés."},"serviceCard":{"learnMore":"En savoir plus"},"caseStudiesPage":{"eyebrow":"Études de cas","title":"Projets récents.","description":"Un échantillon de notre travail — rapports complets sur demande.","items":[{"industry":"Chaîne d'approvisionnement","client":"Larkspur Logistics","summary":"Développement d'un agent de tri qui lit les tickets de support entrants, vérifie le statut des expéditions sur trois systèmes et rédige une résolution à valider.","result":"68 % des tickets sont désormais résolus sans rédaction manuelle depuis zéro."},{"industry":"Données & analytique","client":"Northfield Analytics","summary":"Migration des charges d'inférence vers une architecture cloud dimensionnée sur mesure, remplaçant une configuration générique en fonctionnement continu par un autoscaling adapté au trafic réel.","result":"41 % de réduction des coûts cloud mensuels."},{"industry":"E-commerce","client":"Solvent Home Goods","summary":"Sprint de conseil de deux semaines pour classer les opportunités d'automatisation, suivi du déploiement d'un chatbot de support produit basé sur le catalogue et la politique de retour.","result":"Chatbot en production en 6 semaines ; répond à 35 % des questions avant achat."}]},"contactPage":{"eyebrow":"Contact","title":"Parlez-nous de votre projet.","description":"Partagez quelques détails et nous reviendrons vers vous avec les prochaines étapes — pas de discours commercial, juste une réponse honnête sur la pertinence.","emailLabel":"E-mail","responseTimeLabel":"Délai de réponse","responseTimeValue":"Sous un jour ouvré"},"contactForm":{"nameLabel":"Nom","emailLabel":"E-mail","companyLabel":"Entreprise","phoneLabel":"Téléphone","serviceLabel":"Service qui vous intéresse","servicePlaceholder":"Sélectionner un service","serviceNotSure":"Pas encore sûr","messageLabel":"Message","successTitle":"Message envoyé.","successBody":"Nous répondons à chaque demande sous un jour ouvré.","errorBody":"Une erreur s'est produite lors de l'envoi de votre message. Veuillez réessayer ou nous écrire directement par e-mail.","sending":"Envoi en cours…","submit":"Envoyer le message"},"privacyPage":{"title":"Politique de confidentialité","lastUpdated":"Dernière mise à jour : 17 août 2026","sections":[{"heading":"Aperçu","body":"Cette politique explique quelles informations Enelope (« nous ») collecte via enelope.ch, comment nous les utilisons et avec qui nous les partageons. Elle ne concerne que ce site — des accords séparés régissent tout projet ou mandat client."},{"heading":"Informations que nous collectons","intro":"Nous collectons des informations de deux manières :","bullets":[{"label":"Formulaire de contact.","body":"Lorsque vous soumettez le formulaire de contact, nous recevons votre nom, e-mail, entreprise, numéro de téléphone, service d'intérêt et message."},{"label":"Journaux d'hébergement de base.","body":"Notre hébergeur (Vercel) enregistre automatiquement des données de requête standard (comme l'adresse IP et le type de navigateur) pour la sécurité et la fiabilité. Nous n'utilisons aucun traceur d'analyse ou publicitaire sur ce site."}],"outro":"Votre préférence de thème (mode clair ou sombre) est stockée localement dans votre navigateur et ne nous est jamais transmise."},{"heading":"Comment nous utilisons vos informations","body":"Nous utilisons les soumissions du formulaire de contact uniquement pour répondre à votre demande. Nous ne vendons pas vos données personnelles et ne les utilisons pas à des fins marketing, sauf accord séparé de votre part."},{"heading":"Prestataires tiers","intro":"Nous faisons appel à un petit nombre de sous-traitants pour faire fonctionner ce site et transmettre les messages du formulaire de contact :","providers":[{"name":"Supabase","body":"héberge notre base de données, l'authentification et le stockage de fichiers pour les services et témoignages présentés sur ce site","linkLabel":"politique de confidentialité","href":"https://supabase.com/privacy"},{"name":"Resend","body":"envoie l'e-mail généré lorsque vous soumettez le formulaire de contact","linkLabel":"politique de confidentialité","href":"https://resend.com/legal/privacy-policy"},{"name":"Vercel","body":"héberge ce site","linkLabel":"politique de confidentialité","href":"https://vercel.com/legal/privacy-policy"}]},{"heading":"Cookies","body":"Nous n'utilisons pas de cookies de suivi ou publicitaires. La connexion à l'espace d'administration crée un cookie de session sécurisé et nécessaire, utilisé uniquement pour vous maintenir authentifié."},{"heading":"Conservation des données","body":"Les soumissions du formulaire de contact sont envoyées directement par e-mail à notre équipe et ne sont pas stockées dans une base de données. Le contenu des services et témoignages est conservé dans notre base de données jusqu'à sa suppression par un administrateur."},{"heading":"Vos droits","body":"Vous pouvez nous demander quelles informations nous détenons à votre sujet, ou en demander la suppression, en écrivant à {email}."},{"heading":"Modifications de cette politique","body":"Nous pouvons mettre à jour cette politique de temps à autre. Les changements importants seront reflétés par la mise à jour de la date en haut de cette page."},{"heading":"Contact","body":"Des questions sur cette politique ? Écrivez à {email}."}]},"termsPage":{"title":"Conditions d'utilisation","lastUpdated":"Dernière mise à jour : 17 août 2026","sections":[{"heading":"Acceptation des conditions","body":"En utilisant enelope.ch (le « Site »), vous acceptez ces conditions. Ces conditions régissent uniquement l'utilisation du Site — elles ne régissent aucun mandat payant avec Enelope, qui est couvert par un accord signé séparé ou un cahier des charges."},{"heading":"Utilisation du site","body":"Le Site est fourni à des fins d'information — pour décrire nos services, partager des études de cas et vous permettre de nous contacter. Vous vous engagez à ne pas détourner le Site, y compris en tentant d'obtenir un accès non autorisé à l'espace d'administration ou à toute autre partie non publique du Site."},{"heading":"Recours à nos services","body":"Les descriptions de services sur ce Site sont informatives et ne constituent ni une offre ni un contrat. Le périmètre du projet, les tarifs, les livrables et la propriété des résultats de tout mandat sont définis exclusivement dans un accord écrit séparé entre Enelope et le client."},{"heading":"Propriété intellectuelle","body":"Le contenu et le design du Site, ainsi que le nom et le logo Enelope, appartiennent à Enelope et ne peuvent être copiés ou réutilisés sans autorisation. Cela ne s'applique pas aux livrables produits dans le cadre d'un accord client séparé, régis par les conditions de propriété intellectuelle de cet accord."},{"heading":"Absence de garantie","body":"Le Site est fourni « en l'état », sans garantie d'aucune sorte. Nous ne garantissons pas que le Site sera ininterrompu, exempt d'erreurs ou disponible en permanence."},{"heading":"Limitation de responsabilité","body":"Dans toute la mesure permise par la loi, Enelope n'est pas responsable des dommages indirects, accessoires ou consécutifs résultant de votre utilisation du Site."},{"heading":"Services tiers","body":"Le Site s'appuie sur des prestataires tiers (Supabase, Resend, Vercel) pour fonctionner. Nous ne sommes pas responsables des interruptions ou problèmes provenant de ces prestataires."},{"heading":"Droit applicable","body":"Ces conditions sont régies par le droit suisse, à l'exclusion des règles de conflit de lois."},{"heading":"Modifications de ces conditions","body":"Nous pouvons mettre à jour ces conditions de temps à autre. Les changements importants seront reflétés par la mise à jour de la date en haut de cette page."},{"heading":"Contact","body":"Des questions sur ces conditions ? Écrivez à {email}."}]}}}],"$L12","$L13"]
